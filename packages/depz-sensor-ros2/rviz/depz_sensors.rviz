# RViz 2 view of DEPZ sensors: a Range cone, an IMU's orientation, a depth
# grid, a point cloud.
#
#   ros2 launch depz_sensors view.launch.py
#
# starts the sensors node and RViz with one display of these per topic of your
# boards, whatever their names (scripts/rviz_view.py copies the displays of
# this file), and places the boards side by side. The file as it is,
#
#   rviz2 -d $(ros2 pkg prefix --share depz_sensors)/rviz/depz_sensors.rviz
#
# shows the topics of config/example_aliases.yaml (/depz/front/range,
# /depz/imu/imu, /depz/depth/depth, and /depz/depth/points when `point_cloud`
# is on); with other names, pick your topic in each display's "Topic" field.
# Range, Imu and PointCloud2 are drawn in the board's frame, so RViz needs a
# transform from the fixed frame (base_link) to it: launch/example_robot.launch.py
# publishes them for these three boards, and the README's "Coordinate frames"
# has the command. Every display subscribes best effort, as the node publishes
# (sensor-data QoS).
#
# A topic display has `Enabled: true` and `Value: false` on purpose. Both are
# the display's check box; RViz reads `Value` first and `Enabled` last, and a
# display switched on by `Value` subscribes before its Topic settings are
# read — reliable, which the node answers with a warning per topic
# ("requesting incompatible QoS") — and then once more, best effort. Switched
# on by `Enabled` it subscribes once, best effort. (RViz saves both as true.)
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Range1
        - /Imu1
        - /Depth1
        - /Points1
      Splitter Ratio: 0.6
    Tree Height: 400
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 16
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.3
      Value: true
    - Class: rviz_default_plugins/Range
      Name: Range
      Enabled: true
      Alpha: 0.5
      Buffer Length: 1
      Color: 255; 170; 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /depz/front/range
      Value: false
    - Class: rviz_imu_plugin/Imu
      Name: Imu
      Enabled: true
      Acceleration properties:
        Acc. vector alpha: 1
        Acc. vector color: 255; 0; 0
        Acc. vector scale: 0.05
        Derotate acceleration: true
        Enable acceleration: true
      Axes properties:
        Axes scale: 0.3
        Enable axes: true
      Box properties:
        Box alpha: 1
        Box color: 0; 170; 255
        Enable box: true
        x_scale: 0.2
        y_scale: 0.12
        z_scale: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /depz/imu/imu
      fixed_frame_orientation: true
      Value: false
    - Class: rviz_default_plugins/Image
      Name: Depth
      Enabled: true
      Normalize Range: true
      Max Value: 1
      Min Value: 0
      Median window: 5
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /depz/depth/depth
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Points
      Enabled: true
      Alpha: 1
      Color Transformer: AxisColor
      Axis: X
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: 0
        Value: false
      Use Fixed Frame: false
      Position Transformer: XYZ
      Size (m): 0.02
      Style: Spheres
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /depz/depth/points
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.5
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.1
      Pitch: 0.5
      Yaw: 3.6
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Depth:
    collapsed: false
  Height: 800
  Width: 1200
