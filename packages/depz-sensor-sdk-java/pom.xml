<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.depz-ai</groupId>
  <artifactId>depz-sensor-sdk</artifactId>
  <version>0.7.0</version>
  <packaging>jar</packaging>

  <name>depz-sensor-sdk</name>
  <description>Contract-first Java SDK for the DEPZ USB sensor line (SR04, VL53L4CD ToF, VL53L8CX/CH ToF, BNO086 IMU) — transport, protocol codecs, and sensor decode.</description>
  <url>https://github.com/depz-ai/depz-sensor-sdk</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>DEPZ</name>
      <organization>DEPZ</organization>
      <organizationUrl>https://depz.ai</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/depz-ai/depz-sensor-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/depz-ai/depz-sensor-sdk.git</developerConnection>
    <url>https://github.com/depz-ai/depz-sensor-sdk</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- serial ports on Windows, macOS and Linux (the build scripts pin the same version) -->
    <dependency>
      <groupId>com.fazecast</groupId>
      <artifactId>jSerialComm</artifactId>
      <version>2.11.4</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The VL53L8 / L5 / L7 sensor firmware and ST configuration blobs: the Python SDK's
           vl53l8/data, the one copy every SDK reads (build.sh copies it the same way). -->
      <resource>
        <directory>../depz-sensor-sdk-python/depz_sensor_sdk/vl53l8/data</directory>
        <targetPath>ai/depz/sensor/sensors/vl53l8/data</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- sources jar (required by Maven Central) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- javadoc jar (required by Maven Central) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <doclint>none</doclint>
          <quiet>true</quiet>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- GPG signing (required by Maven Central) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <version>3.2.7</version>
        <executions>
          <execution>
            <id>sign-artifacts</id>
            <phase>verify</phase>
            <goals><goal>sign</goal></goals>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Sonatype Central Portal publishing.
           0.12.0, not 0.8.0: Maven 3.10.0 (GitHub runners from 2026-10) stages
           maven-metadata-local.xml + _remote.repositories, and 0.8.0 only
           pre-bundle-deletes maven-metadata-central-staging.xml (Maven 3.9's
           name), so the portal failed java 0.4.2 and the first 0.4.3 upload:
           "Bundle has content that does NOT have a .pom file". -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.12.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>true</autoPublish>
          <!-- Wait for the portal's validation, so a rejected bundle turns the
               publish run red (with waitUntil=uploaded both failures above
               left it green). Not "published": that step can take hours. -->
          <waitUntil>validated</waitUntil>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
