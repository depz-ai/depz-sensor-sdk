<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.depz-ai</groupId>
  <artifactId>depz-sensor-sdk</artifactId>
  <version>0.8.0</version>
  <packaging>jar</packaging>

  <name>depz-sensor-sdk</name>
  <description>Contract-first Java SDK for the DEPZ USB sensor line (SR04, VL53L4CD ToF, VL53L8CX/CH ToF, BNO086 IMU) — transport, protocol codecs, and sensor decode.</description>
  <url>https://github.com/depz-ai/depz-sensor-sdk</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>DEPZ</name>
      <organization>DEPZ</organization>
      <organizationUrl>https://depz.ai</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/depz-ai/depz-sensor-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/depz-ai/depz-sensor-sdk.git</developerConnection>
    <url>https://github.com/depz-ai/depz-sensor-sdk</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- The vector harness and the device tests run in `mvn test` through exec-maven-plugin
         (the harness has no JUnit); -Dmaven.test.skip=true skips them as it skips surefire. -->
    <maven.test.skip>false</maven.test.skip>
    <depz.vectors>${project.basedir}/../../contracts/vectors</depz.vectors>
    <!-- Line-coverage floor (ratio of the whole jar), checked by `mvn test`: the measured total
         rounded down. Raise it when the tests grow; never lower it to make a change pass. -->
    <jacoco.line.floor>0.86</jacoco.line.floor>
  </properties>

  <dependencies>
    <!-- serial ports on Windows, macOS and Linux (the build scripts pin the same version) -->
    <dependency>
      <groupId>com.fazecast</groupId>
      <artifactId>jSerialComm</artifactId>
      <version>2.11.4</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The VL53L8 / L5 / L7 sensor firmware and ST configuration blobs: the Python SDK's
           vl53l8/data, the one copy every SDK reads (build.sh copies it the same way). -->
      <resource>
        <directory>../depz-sensor-sdk-python/depz_sensor_sdk/vl53l8/data</directory>
        <targetPath>ai/depz/sensor/sensors/vl53l8/data</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- The golden-vector harness and the device tests (test.sh runs the same two mains
           with plain javac; CI runs test.sh). ${argLine} is the JaCoCo agent, set by
           prepare-agent at run time (not a pom property: Maven would interpolate that one
           before the agent sets it), so this plugin needs the one below. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <skip>${maven.test.skip}</skip>
          <executable>java</executable>
          <classpathScope>test</classpathScope>
        </configuration>
        <executions>
          <execution>
            <id>run-vectors</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <arguments>
                <argument>${argLine}</argument>
                <argument>-cp</argument>
                <classpath/>
                <argument>ai.depz.sensor.test.RunVectors</argument>
                <argument>${depz.vectors}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>run-device-tests</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <arguments>
                <argument>${argLine}</argument>
                <argument>-cp</argument>
                <classpath/>
                <argument>ai.depz.sensor.test.RunDeviceTests</argument>
                <argument>${depz.vectors}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Coverage: the two mains above run under the JaCoCo agent; `report` writes
           target/site/jacoco/ (index.html, jacoco.xml, jacoco.csv) and `check` fails the build
           below the line floor. Declared after exec-maven-plugin: same phase, pom order. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>test</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.floor}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- sources jar (required by Maven Central) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- javadoc jar (required by Maven Central) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <doclint>none</doclint>
          <quiet>true</quiet>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- GPG signing (required by Maven Central) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <version>3.2.7</version>
        <executions>
          <execution>
            <id>sign-artifacts</id>
            <phase>verify</phase>
            <goals><goal>sign</goal></goals>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Sonatype Central Portal publishing.
           0.12.0, not 0.8.0: Maven 3.10.0 (GitHub runners from 2026-10) stages
           maven-metadata-local.xml + _remote.repositories, and 0.8.0 only
           pre-bundle-deletes maven-metadata-central-staging.xml (Maven 3.9's
           name), so the portal failed java 0.4.2 and the first 0.4.3 upload:
           "Bundle has content that does NOT have a .pom file". -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.12.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>true</autoPublish>
          <!-- Wait for the portal's validation, so a rejected bundle turns the
               publish run red (with waitUntil=uploaded both failures above
               left it green). Not "published": that step can take hours. -->
          <waitUntil>validated</waitUntil>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
