@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# The live-hardware layer links Threads::Threads on POSIX.
if(NOT WIN32)
  set(THREADS_PREFER_PTHREAD_FLAG ON)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/depz-sensor-sdk-c-targets.cmake")

check_required_components(depz-sensor-sdk-c)
